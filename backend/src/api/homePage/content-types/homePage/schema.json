    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "home.stat-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "recentUpdates": {
      "type": "component",
      "repeatable": true,
