      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "missionParagraph": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroSlides": {
      "type": "component",
      "repeatable": true,
      "component": "home.hero-slide",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "navCards": {
      "type": "component",
      "repeatable": true,
      "component": "home.nav-card",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
