    "ctaPrimaryButton": {
      "type": "component",
      "repeatable": false,
      "component": "home.cta-button",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ctaSecondaryButton": {
      "type": "component",
      "repeatable": false,
      "component": "home.cta-button",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
